#!/usr/bin/env python3

import os
import csv
import re
import logging
from bs4 import BeautifulSoup
import html
from collections import defaultdict
from concurrent.futures import ProcessPoolExecutor, as_completed

# ------------------------------------------------------------
# Configuration
# ------------------------------------------------------------
base_dir = '/XXXX/XXXXX/XXXXXX/results_rhizosmash'
species_map_path = '/XXXX/XXXX/XXXXXX/data_rhizo_anti_SMASH/species_total.csv'
output_file = 'rhizosmash_results_summary.tsv'
error_file = 'failed_genomes.txt'

logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s',
    handlers=[
        logging.FileHandler('rhizosmash_processing.log'),
        logging.StreamHandler()
    ]
)

# ------------------------------------------------------------
# Load species mapping
# ------------------------------------------------------------
species_mapping = {}
try:
    with open(species_map_path, 'r') as f:
        reader = csv.reader(f)
        next(reader)  # skip header
        for row in reader:
            if len(row) >= 2 and row[0].strip() and row[1].strip():
                genome_id = row[0].strip()
                species = row[1].strip().rstrip(',')
                species_mapping[genome_id] = species
            else:
                logging.warning(f"Row skipped due to format: {row}")
except Exception as e:
    logging.error(f"Error reading species mapping: {e}")
    exit(1)

logging.info(f"Species mapping loaded: {len(species_mapping)} entries")

# ------------------------------------------------------------
# Find result folders
# ------------------------------------------------------------
all_dirs = [d for d in os.listdir(base_dir)
            if os.path.isdir(os.path.join(base_dir, d)) and d.startswith('out_')]
logging.info(f"Found {len(all_dirs)} result folders")

# ------------------------------------------------------------
# Helper functions
# ------------------------------------------------------------
def clean_text(text):
    """Cleans HTML entities and extra spaces."""
    if not text:
        return text
    text = html.unescape(text)
    text = text.replace('\xa0', ' ').replace('&nbsp;', ' ')
    text = re.sub(r'[^\S\n]+', ' ', text)
    return text.strip()

def extract_genome_id_from_dir(dirname):
    """
    Extracts the genome identifier from the folder name.
    Example: out_GCF_000239815.1_ASM23981v2_genomic -> GCF_000239815.1
    """
    base = dirname[4:]  # remove 'out_'
    if base.endswith('_genomic'):
        base = base[:-8]  # remove '_genomic'
    parts = base.split('_')
    if len(parts) >= 2:
        return f"{parts[0]}_{parts[1]}"
    return base  # fallback

def extract_rhizosmash_info(dir_path, genome_id, species):
    """Extracts all regions from index.html."""
    html_path = os.path.join(dir_path, 'index.html')
    if not os.path.exists(html_path):
        logging.warning(f"index.html not found in {dir_path}")
        return []

    try:
        with open(html_path, 'r', encoding='utf-8') as f:
            soup = BeautifulSoup(f.read(), 'html.parser')
    except Exception as e:
        logging.error(f"Error reading {html_path}: {e}")
        return []

    regions = []

    # Find all record detail divs
    detail_divs = soup.find_all('div', class_='record-overview-details')
    for div in detail_divs:
        table = div.find('table', class_='region-table')
        if not table:
            continue

        # Skip header
        rows = table.find_all('tr')[1:]
        for row in rows:
            cells = row.find_all('td')
            if not cells:
                continue

            # Extract region (first cell)
            region_cell = cells[0]
            region_link = region_cell.find('a')
            region = clean_text(region_link.get_text()) if region_link else clean_text(region_cell.get_text())

            # Extract type (second cell)
            type_cell = cells[1]
            type_links = type_cell.find_all('a')
            if type_links:
                region_type = ', '.join(clean_text(link.get_text()) for link in type_links)
            else:
                region_type = clean_text(type_cell.get_text())

            # Coordinates (third and fourth cells)
            from_coord = clean_text(cells[2].get_text())
            to_coord = clean_text(cells[3].get_text())

            # Number of cells determines if there is a similar cluster
            if len(cells) == 5:
                # No similar cluster (colspan=3)
                most_similar = ''
                category = ''
                similarity = ''
            elif len(cells) == 7:
                # There is a cluster: cell4 = name, cell5 = category, cell6 = similarity
                most_similar = clean_text(cells[4].get_text())
                category = clean_text(cells[5].get_text())
                similarity = clean_text(cells[6].get_text())
            else:
                # Unexpected number, log and skip
                logging.debug(f"Unexpected number of cells ({len(cells)}) in {html_path}")
                continue

            # Use genome as "Record" (no record identifier in RhizoSMASH)
            record = genome_id

            regions.append({
                'Genome': genome_id,
                'Record': record,
                'Species': species,
                'Region': region,
                'Type': region_type,
                'From': from_coord,
                'To': to_coord,
                'Most_Similar_Cluster': most_similar,
                'Category': category,
                'Similarity': similarity,
                'File': os.path.basename(dir_path)  # folder name
            })

    return regions

# ------------------------------------------------------------
# Process each folder (sequential or parallel)
# ------------------------------------------------------------
if os.path.exists(error_file):
    os.remove(error_file)

all_results = []
failed_count = 0

# Option 1: sequential processing (simpler for debugging)
for dir_name in all_dirs:
    dir_path = os.path.join(base_dir, dir_name)
    genome_id = extract_genome_id_from_dir(dir_name)
    species = species_mapping.get(genome_id, 'Unknown')
    if species == 'Unknown':
        logging.warning(f"No species found for {genome_id} (dir {dir_name})")

    try:
        regions = extract_rhizosmash_info(dir_path, genome_id, species)
        if regions:
            all_results.extend(regions)
            logging.info(f"Processed {dir_name}: {len(regions)} regions")
        else:
            logging.warning(f"No regions found in {dir_name}")
    except Exception as e:
        logging.error(f"Error processing {dir_name}: {e}")
        failed_count += 1
        with open(error_file, 'a') as err_f:
            err_f.write(f"{dir_name}\t{str(e)}\n")

# Option 2: parallel processing (uncomment to use)
# with ProcessPoolExecutor(max_workers=os.cpu_count()) as executor:
#     future_to_dir = {executor.submit(extract_rhizosmash_info, os.path.join(base_dir, d), extract_genome_id_from_dir(d), species_mapping.get(extract_genome_id_from_dir(d), 'Unknown')): d for d in all_dirs}
#     for future in as_completed(future_to_dir):
#         dir_name = future_to_dir[future]
#         try:
#             regions = future.result()
#             if regions:
#                 all_results.extend(regions)
#                 logging.info(f"Processed {dir_name}: {len(regions)} regions")
#             else:
#                 logging.warning(f"No regions found in {dir_name}")
#         except Exception as e:
#             logging.error(f"Error processing {dir_name}: {e}")
#             failed_count += 1
#             with open(error_file, 'a') as err_f:
#                 err_f.write(f"{dir_name}\t{str(e)}\n")

# ------------------------------------------------------------
# Write results
# ------------------------------------------------------------
if all_results:
    fieldnames = ['Genome', 'Record', 'Species', 'Region', 'Type', 'From', 'To',
                  'Most_Similar_Cluster', 'Category', 'Similarity', 'File']

    with open(output_file, 'w', newline='', encoding='utf-8') as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames, delimiter='\t')
        writer.writeheader()
        writer.writerows(all_results)

    unique_genomes = len(set(r['Genome'] for r in all_results))
    regions_by_type = defaultdict(int)
    for r in all_results:
        regions_by_type[r['Type']] += 1

    logging.info("Processing completed:")
    logging.info(f"- Total regions: {len(all_results)}")
    logging.info(f"- Genomes processed: {unique_genomes}")
    logging.info(f"- Failed: {failed_count}")
    logging.info("Most frequent region types:")
    for t, cnt in sorted(regions_by_type.items(), key=lambda x: x[1], reverse=True)[:20]:
        logging.info(f"  {t}: {cnt}")

    # Save summary
    with open('processing_summary.txt', 'w') as sum_f:
        sum_f.write(f"Folders processed: {len(all_dirs)}\n")
        sum_f.write(f"Genomes with data: {unique_genomes}\n")
        sum_f.write(f"Failed: {failed_count}\n")
        sum_f.write(f"Total regions: {len(all_results)}\n\n")
        sum_f.write("Region types (top 20):\n")
        for t, cnt in sorted(regions_by_type.items(), key=lambda x: x[1], reverse=True)[:20]:
            sum_f.write(f"{t}: {cnt}\n")
else:
    logging.error("No results found")

logging.info("Process finished")

