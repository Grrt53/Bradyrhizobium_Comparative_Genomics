#!/usr/bin/env python3

import pandas as pd
import os

# =============================================================================
# PATH CONFIGURATION (modify according to your system)
# =============================================================================
TSV_PATH = "/xxxx/xxxxx/xxxxxxx/antismash_results_filtrado.tsv"
MATRIX_PATH = "presence_matrix_antismash.csv"
CLUSTER_DB_PATH = "clusters_db_antismash.csv"
DUPLICATES_LOG_PATH = "duplicates_cluster_species_with_records_antismash.txt"

# =============================================================================
# MAIN FUNCTION
# =============================================================================
def process_rhizosmash(tsv_path, output_matrix, output_db, output_log):
    """
    Reads the rhizoSMASH TSV, generates:
      - Numeric presence matrix (species x clusters).
      - Cluster database (cluster + category).
      - Log file with details of multiple regions per species/cluster.
    """
    
    # 1. Load data
    print(f"Paste Reading file: {tsv_path}")
    df = pd.read_csv(tsv_path, sep='\t')
    df.columns = df.columns.str.strip()
    
    # Check required columns (we add Record and Region for the log)
    required_columns = ['Genome', 'Species', 'Region', 'Type', 'Similarity', 'Most_Similar_Cluster']
    for col in required_columns:
        if col not in df.columns:
            raise ValueError(f"Missing column '{col}' in file. Columns found: {list(df.columns)}")
    
    # 2. Map Similarity to numeric value
    sim_map = {'Low': 1, 'Medium': 2, 'High': 3}
    df['Sim_value'] = df['Similarity'].map(sim_map)
    
    # Check for unmapped values
    unmapped = df[df['Sim_value'].isna()]['Similarity'].unique()
    if len(unmapped) > 0:
        print(f"X  Warning: Unrecognized Similarity values: {unmapped}. Will assign 0.")
        df['Sim_value'] = df['Sim_value'].fillna(0).astype(int)
    else:
        df['Sim_value'] = df['Sim_value'].astype(int)
    
    # 3. Detect species with multiple regions of the same cluster
    #    Group to count how many regions per (species, cluster)
    counts = df.groupby(['Species', 'Most_Similar_Cluster']).size().reset_index(name='num_regions')
    duplicate_clusters = counts[counts['num_regions'] > 1]
    
    if duplicate_clusters.empty:
        print("ℹ️  No clusters found with more than one region per species.")
        with open(output_log, 'w', encoding='utf-8') as f:
            f.write("No clusters with multiple regions were detected for the same species.\n")
    else:
        # For each case with multiple regions, get details
        log_lines = []
        log_lines.append("=" * 80 + "\n")
        log_lines.append("DETAIL OF CLUSTERS WITH MULTIPLE REGIONS PER SPECIES\n")
        log_lines.append("=" * 80 + "\n\n")
        
        for _, row in duplicate_clusters.iterrows():
            sp = row['Species']
            clust = row['Most_Similar_Cluster']
            
            # Filter original dataframe for this species-cluster pair
            subdf = df[(df['Species'] == sp) & (df['Most_Similar_Cluster'] == clust)].copy()
            subdf = subdf.sort_values('Record')
            
            # Get unique numeric similarity values
            unique_values = sorted(subdf['Sim_value'].unique())
            max_value = subdf['Sim_value'].max()
            
            # Build log entry
            log_lines.append(f"Species: {sp}\n")
            log_lines.append(f"Cluster: {clust}\n")
            log_lines.append(f"Similarity values found: {unique_values}\n")
            log_lines.append("Regions involved:\n")
            
            for _, reg in subdf.iterrows():
                sim_original = reg['Similarity']
                sim_num = reg['Sim_value']
                log_lines.append(f"  - Record: {reg['Record']} | Region: {reg['Region']} | Similarity: {sim_original} ({sim_num})\n")
            
            log_lines.append(f"Value kept (maximum): {max_value}\n")
            log_lines.append("-" * 40 + "\n\n")
        
        # Save log file
        with open(output_log, 'w', encoding='utf-8') as f:
            f.writelines(log_lines)
        print(f"V Log file with record details saved to: {output_log}")
    
    # 4. Build cluster database (Most_Similar_Cluster -> Category)
    cluster_db = df[['Most_Similar_Cluster', 'Type']].drop_duplicates(subset='Most_Similar_Cluster')
    cluster_db = cluster_db.sort_values('Most_Similar_Cluster').reset_index(drop=True)
    cluster_db.to_csv(output_db, sep=';', index=False)
    print(f"V Cluster database saved to: {output_db}")
    
    # 5. Create presence matrix (maximum value per species and cluster)
    matrix = df.pivot_table(index='Species',
                            columns='Most_Similar_Cluster',
                            values='Sim_value',
                            aggfunc='max',
                            fill_value=0)
    
    matrix.to_csv(output_matrix, sep=';')
    print(f"V Presence matrix saved to: {output_matrix}")
    print(f"V Dimensions: {matrix.shape[0]} species x {matrix.shape[1]} clusters")

# =============================================================================
# EXECUTION
# =============================================================================
if __name__ == "__main__":
    # Check that the input file exists
    if not os.path.exists(TSV_PATH):
        print(f"X Error: TSV file not found at:\n{TSV_PATH}")
        print("Please edit the TSV_PATH variable in the script with the correct path.")
    else:
        process_rhizosmash(TSV_PATH, MATRIX_PATH, CLUSTER_DB_PATH, DUPLICATES_LOG_PATH)
