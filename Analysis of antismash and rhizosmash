#!/bin/bash

# ============================
# CONFIGURATION
# ============================

INPUT_DIR="list_bueno_brady"   # folder containing the .gbff files
OUTDIR="results_rhizosmash"
LOGDIR="logs_rhizosmash"

THREADS=20

# ============================
# PREPARATION
# ============================

mkdir -p $OUTDIR
mkdir -p $LOGDIR

echo "======================================"
echo "RhizoSMASH batch started"
echo "Searching for .gbff files in: $INPUT_DIR"
echo "======================================"

# ============================
# EXECUTION
# ============================

find $INPUT_DIR -name "*.gbff" | parallel -j $THREADS '
file={};
base=$(basename $file .gbff)

OUT="'$OUTDIR'/out_$base"
LOG="'$LOGDIR'/$base.log"

if [ ! -d "$OUT" ]; then
    echo "Processing $base..."

    rhizosmash "$file" \
        --output-dir "$OUT" \
        --cb-knownclusters \
        --genefinding-tool prodigal \
        > "$LOG" 2>&1

    echo "OK $base"
else
    echo "SKIP $base"
fi
'

echo "======================================"
echo "FINISHED"
echo "======================================"


