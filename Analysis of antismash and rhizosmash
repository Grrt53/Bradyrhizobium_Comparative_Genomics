#!/usr/bin/env python3

import os
import csv
import glob
import zipfile
import tarfile
import concurrent.futures
from collections import defaultdict
import logging
import re
from bs4 import BeautifulSoup
import html

# Logging configuration
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s',
    handlers=[
        logging.FileHandler('antismash_processing.log'),
        logging.StreamHandler()
    ]
)

# Configure paths
base_dir = '/xxx/xxxx/xxxxx4/results_anti_mash'
species_map_path = '/xxxx/xxxx/xxxxx/species_total.csv'
output_file = 'antismash_results_summary.tsv'
error_file = 'failed_genomes.txt'

# Read species mapping
species_mapping = {}
try:
    with open(species_map_path, 'r') as f:
        reader = csv.reader(f)
        next(reader)  # Skip header
        for row in reader:
            if len(row) >= 2 and row[0].strip() and row[1].strip():
                genome_id = row[0].strip()
                species = row[1].strip().rstrip(',')
                species_mapping[genome_id] = species
            else:
                logging.warning(f"Row skipped due to incorrect format: {row}")
except Exception as e:
    logging.error(f"Error reading species mapping: {e}")
    exit(1)

logging.info(f"Species mapping loaded: {len(species_mapping)} entries")

# Find all compressed files (both .zip and .tar.gz)
compressed_files = glob.glob(os.path.join(base_dir, '*.zip')) + glob.glob(os.path.join(base_dir, '*.tar.gz'))

logging.info(f"Found {len(compressed_files)} compressed files")

def clean_text(text):
    """Cleans text of special characters but keeps commas and periods"""
    if not text:
        return text
    
    # Decode HTML entities
    text = html.unescape(text)
    
    # Replace non-breaking spaces with normal spaces
    text = text.replace('\xa0', ' ').replace('&nbsp;', ' ')
    
    # Remove multiple spaces but keep commas and periods
    text = re.sub(r'[^\S\n]+', ' ', text)
    
    return text.strip()

def format_coordinates(coord_text):
    """Formats coordinates keeping commas for better readability"""
    if not coord_text:
        return coord_text
    
    # Clean the text
    coord_text = clean_text(coord_text)
    
    # Remove any spaces inside the number but keep commas
    coord_text = coord_text.replace(' ', '')
    
    # Ensure commas are correctly placed (every 3 digits)
    try:
        # If it already has commas, check they are in correct positions
        if ',' in coord_text:
            # Check if commas are in correct positions
            parts = coord_text.split(',')
            # If all parts except the first have 3 digits, it's well formatted
            if all(len(part) == 3 for part in parts[1:]):
                return coord_text
            else:
                # Reformat if commas are not in correct positions
                num = int(coord_text.replace(',', ''))
                return f"{num:,}"
        else:
            # Add commas if missing
            num = int(coord_text)
            return f"{num:,}"
    except ValueError:
        # If not a number, return cleaned text
        return coord_text

def extract_overview_from_html(html_content, genome_id, species):
    """Extracts antiSMASH overview information from HTML content"""
    soup = BeautifulSoup(html_content, 'html.parser')
    regions = []
    
    # Find all record headers
    record_headers = soup.find_all('div', class_='record-overview-header')
    
    for header in record_headers:
        # Extract record ID and species
        strong_tag = header.find('strong')
        if not strong_tag:
            continue
            
        record_text = clean_text(strong_tag.get_text())
        # Format is: "ID (species)"
        record_parts = record_text.split('(')
        if len(record_parts) >= 2:
            record_id = clean_text(record_parts[0])
            record_species = clean_text(record_parts[1].rstrip(')'))
        else:
            record_id = clean_text(record_text)
            record_species = species
        
        # Find region table for this record
        record_details = header.find_next_sibling('div', class_='record-overview-details')
        if not record_details:
            continue
            
        overview_table = record_details.find('table', class_='region-table')
        if not overview_table:
            continue
        
        # Extract table rows (skip header)
        rows = overview_table.find_all('tr')[1:]
        
        for row in rows:
            cells = row.find_all('td')
            if len(cells) < 4:
                continue
                
            # Extract region number
            region_cell = cells[0]
            region_link = region_cell.find('a')
            if region_link:
                region_text = clean_text(region_link.get_text())
            else:
                region_text = clean_text(region_cell.get_text())
            
            # Extract type
            type_cell = cells[1]
            type_links = type_cell.find_all('a')
            if type_links:
                region_type = ', '.join([clean_text(link.get_text()) for link in type_links])
            else:
                region_type = clean_text(type_cell.get_text())
            
            # Extract coordinates - keep commas for readability
            from_coord = format_coordinates(cells[2].get_text())
            to_coord = format_coordinates(cells[3].get_text())
            
            # Extract similarity and similar cluster (if available)
            similarity = ""
            similar_cluster = ""
            
            if len(cells) > 4:
                similarity_cell = cells[4]
                if 'similarity-text' in similarity_cell.get('class', []):
                    similarity = clean_text(similarity_cell.get_text())
                    
                    if len(cells) > 5:
                        cluster_cell = cells[5]
                        cluster_link = cluster_cell.find('a')
                        if cluster_link:
                            similar_cluster = clean_text(cluster_link.get_text())
                        else:
                            similar_cluster = clean_text(cluster_cell.get_text())
            
            regions.append({
                'Genome': genome_id,
                'Record': record_id,
                'Species': record_species,
                'Region': region_text,
                'Type': region_type,
                'From': from_coord,
                'To': to_coord,
                'Similarity': similarity,
                'Most_Similar_Cluster': similar_cluster,
                'File': f"{genome_id}.tar.gz"
            })
    
    return regions

def find_and_read_html(compressed_file):
    """Finds and reads HTML content from a compressed file without fully extracting it"""
    html_content = None
    
    try:
        if compressed_file.endswith('.zip'):
            with zipfile.ZipFile(compressed_file, 'r') as zip_ref:
                # Look for index.html
                html_files = [f for f in zip_ref.namelist() if f.endswith('index.html')]
                if not html_files:
                    # Look for any HTML
                    html_files = [f for f in zip_ref.namelist() if f.endswith('.html')]
                
                if html_files:
                    with zip_ref.open(html_files[0]) as f:
                        html_content = f.read().decode('utf-8')
        
        elif compressed_file.endswith('.tar.gz'):
            with tarfile.open(compressed_file, 'r:gz') as tar_ref:
                # Look for index.html
                html_files = [m for m in tar_ref.getmembers() 
                             if m.name.endswith('index.html') and m.isfile()]
                if not html_files:
                    # Look for any HTML
                    html_files = [m for m in tar_ref.getmembers() 
                                 if m.name.endswith('.html') and m.isfile()]
                
                if html_files:
                    f = tar_ref.extractfile(html_files[0])
                    html_content = f.read().decode('utf-8')
                    f.close()
    
    except Exception as e:
        logging.error(f"Error reading HTML from {compressed_file}: {e}")
    
    return html_content

def extract_antismash_info(compressed_file):
    """Extracts antiSMASH overview information from a compressed file"""
    genome_results = []
    base_name = os.path.basename(compressed_file).replace('.tar.gz', '').replace('.zip', '')
    
    # Look for genome ID in species mapping
    genome_id = None
    species = 'Unknown'
    
    # Try different ID variants
    possible_ids = [base_name, base_name[:15], base_name.split('_')[0]]
    for pid in possible_ids:
        if pid in species_mapping:
            genome_id = pid
            species = species_mapping[pid]
            break
    
    if genome_id is None:
        genome_id = base_name
    
    try:
        # Read HTML content directly from compressed file
        html_content = find_and_read_html(compressed_file)
        
        if not html_content:
            logging.warning(f"No HTML found in {compressed_file}")
            return []
        
        # Extract overview information
        regions = extract_overview_from_html(html_content, genome_id, species)
        
        if regions:
            logging.info(f"Processed {compressed_file} - {len(regions)} regions found")
            return regions
        else:
            logging.warning(f"No regions found in overview of {compressed_file}")
            return []
        
    except Exception as e:
        logging.error(f"Error processing {compressed_file}: {e}")
        # Save failed genome
        with open(error_file, 'a') as err_f:
            err_f.write(f"{compressed_file}\t{str(e)}\n")
        return []

# Clean error file
if os.path.exists(error_file):
    os.remove(error_file)

# Process files in parallel
all_results = []
failed_count = 0

# Use parallel processing
with concurrent.futures.ProcessPoolExecutor(max_workers=min(os.cpu_count(), 8)) as executor:
    future_to_file = {executor.submit(extract_antismash_info, f): f for f in compressed_files}
    
    for i, future in enumerate(concurrent.futures.as_completed(future_to_file)):
        file = future_to_file[future]
        try:
            result = future.result()
            all_results.extend(result)
            
            # Show progress every 10 files
            if (i + 1) % 10 == 0:
                logging.info(f"Processed {i + 1}/{len(compressed_files)} files, {len(all_results)} regions found")
                
        except Exception as e:
            logging.error(f"Error processing {file}: {e}")
            failed_count += 1

# Write results
if all_results:
    # Ensure all fields are present
    fieldnames = ['Genome', 'Record', 'Species', 'Region', 'Type', 'From', 'To', 
                  'Similarity', 'Most_Similar_Cluster', 'File']
    
    with open(output_file, 'w', newline='', encoding='utf-8') as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames, delimiter='\t')
        writer.writeheader()
        writer.writerows(all_results)
    
    # Statistics
    unique_genomes = len(set(r['Genome'] for r in all_results))
    regions_by_type = defaultdict(int)
    
    for r in all_results:
        regions_by_type[r['Type']] += 1
    
    logging.info(f"Processing completed:")
    logging.info(f"- Total regions found: {len(all_results)}")
    logging.info(f"- Total genomes processed: {unique_genomes}")
    logging.info(f"- Failed files: {failed_count}")
    
    logging.info(f"- Region type distribution:")
    for region_type, count in sorted(regions_by_type.items(), key=lambda x: x[1], reverse=True)[:20]:
        logging.info(f"  {region_type}: {count}")
    
    # Save summary
    with open('processing_summary.txt', 'w') as summary:
        summary.write(f"Total files processed: {len(compressed_files)}\n")
        summary.write(f"Genomes successfully processed: {unique_genomes}\n")
        summary.write(f"Failed files: {failed_count}\n")
        summary.write(f"Total BGC regions found: {len(all_results)}\n")
        summary.write("\nRegion type distribution (top 20):\n")
        for region_type, count in sorted(regions_by_type.items(), key=lambda x: x[1], reverse=True)[:20]:
            summary.write(f"{region_type}: {count}\n")
    
else:
    logging.error("No results found to process")

logging.info("Process finished")

