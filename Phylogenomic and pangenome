##!/usr/bin/env python3

import pandas as pd
import os
import sys

def main():

    # Define input directories and files
    base_dir = "/9_orthofinder/genomes_represent/OrthoFinder/Results_Mar03/"
    species_file = "/9_orthofinder/species_hector.ods"

    # 1. Load the gene-to-genome mapping
    try:
        gene_genome = pd.read_csv(
            os.path.join(base_dir, "gene_to_genome_final.tsv"),
            sep="\t",
            header=None,
            names=["gene", "genome_full"]
        )

        # Standardize genome accession lengths
        gene_genome["genome"] = gene_genome["genome_full"].apply(
            lambda x: x[:15] if len(x) > 15 else x
        )

    except FileNotFoundError:
        print("ERROR: gene_to_genome_final.tsv was not found.")
        sys.exit(1)

    # 2. Load the genome-to-species mapping
    try:
        genome_species = pd.read_excel(
            species_file,
            engine="odf"
        )

        # Normalize column names
        genome_species.columns = [
            col.strip().lower() for col in genome_species.columns
        ]

        # Select the relevant columns
        if {"genome", "species"}.issubset(genome_species.columns):
            genome_species = genome_species[["genome", "species"]]
        else:
            print(
                "ERROR: The ODS file must contain "
                "'genome' and 'species' columns."
            )
            sys.exit(1)

        # Standardize genome accession lengths
        genome_species["genome"] = genome_species["genome"].apply(
            lambda x: x[:15] if len(x) > 15 else x
        )

    except Exception as e:
        print(f"ERROR reading the species mapping file: {e}")
        sys.exit(1)

    # 3. Merge the mappings
    merged = gene_genome.merge(
        genome_species,
        on="genome",
        how="left"
    )

    merged["species"] = merged["species"].fillna("Unknown_species")

    # Replace spaces in species names with underscores
    merged["species"] = merged["species"].str.replace(" ", "_")

    # 4. Save the final gene-to-species mapping
    merged[["gene", "species"]].to_csv(
        os.path.join(base_dir, "gene_to_species_final.tsv"),
        sep="\t",
        index=False,
        header=False
    )

    # 5. Process single-copy orthologue FASTA files
    input_dir = os.path.join(
        base_dir,
        "Single_Copy_Orthologue_Sequences"
    )

    output_dir = os.path.join(
        base_dir,
        "Species_Named_Orthogroups"
    )

    os.makedirs(output_dir, exist_ok=True)

    # Create the gene-to-species dictionary
    gene_to_species = dict(
        zip(merged["gene"], merged["species"])
    )

    total_genes = 0
    mapped_genes = 0

    # Rename FASTA headers
    for filename in os.listdir(input_dir):
        if filename.endswith(".fa"):

            input_path = os.path.join(input_dir, filename)
            output_path = os.path.join(output_dir, filename)

            with open(input_path, "r") as infile, \
                 open(output_path, "w") as outfile:

                for line in infile:

                    if line.startswith(">"):
                        gene_id = line[1:].strip()
                        total_genes += 1

                        species = gene_to_species.get(
                            gene_id,
                            "Unknown_species"
                        )

                        if species != "Unknown_species":
                            mapped_genes += 1

                        outfile.write(
                            f">{species}|{gene_id}\n"
                        )

                    else:
                        outfile.write(line)

    # 6. Print the final report
    mapping_percentage = (
        mapped_genes / total_genes * 100
        if total_genes > 0 else 0
    )

    print("\nProcessing completed successfully.")
    print(f"Total genes processed: {total_genes}")
    print(
        f"Successfully mapped genes: "
        f"{mapped_genes} ({mapping_percentage:.2f}%)"
    )
    print(f"Unmapped genes: {total_genes - mapped_genes}")
    print(f"Renamed FASTA files: {output_dir}")


if __name__ == "__main__":
    main()


