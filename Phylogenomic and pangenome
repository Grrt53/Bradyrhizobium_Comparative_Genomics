# STEP: 5  Concatenate the Aligned Orthogroups

#!/usr/bin/env python3

from Bio import AlignIO
import os

input_dir = (
    "/9_orthofinder/genomes_represent/OrthoFinder/"
    "Results_Mar03/mafft_alignments"
)

output_file = "super_matrix_concatenated.fas"

# 1. Collect unique species and alignment filenames
species_set = set()
file_list = []

for filename in os.listdir(input_dir):

    if filename.endswith(".aln"):
        file_list.append(filename)

        alignment = AlignIO.read(
            os.path.join(input_dir, filename),
            "fasta"
        )

        for record in alignment:
            species_id = record.id.split("|")[0]
            species_set.add(species_id)

species_list = sorted(species_set)
file_list = sorted(file_list)

# 2. Initialize concatenated sequences
concatenated_sequences = {
    species: [] for species in species_list
}

# 3. Concatenate alignments in a consistent order
for filename in file_list:

    alignment = AlignIO.read(
        os.path.join(input_dir, filename),
        "fasta"
    )

    alignment_length = alignment.get_alignment_length()

    current_sequences = {}

    for record in alignment:
        species = record.id.split("|")[0]
        current_sequences[species] = str(record.seq)

    # Insert gaps for species missing from an orthogroup
    for species in species_list:

        if species in current_sequences:
            concatenated_sequences[species].append(
                current_sequences[species]
            )
        else:
            concatenated_sequences[species].append(
                "-" * alignment_length
            )

# 4. Combine individual alignments
for species in species_list:
    concatenated_sequences[species] = "".join(
        concatenated_sequences[species]
    )

# 5. Write the concatenated supermatrix in FASTA format
with open(output_file, "w") as outfile:

    for species in species_list:

        outfile.write(f">{species}\n")

        sequence = concatenated_sequences[species]

        for i in range(0, len(sequence), 80):
            outfile.write(sequence[i:i + 80] + "\n")

# 6. Print summary statistics
total_length = (
    len(concatenated_sequences[species_list[0]])
    if species_list else 0
)

print("Concatenated supermatrix generated successfully.")
print(f"Number of species: {len(species_list)}")
print(f"Total alignment length: {total_length}")
print(f"Number of orthogroups: {len(file_list)}")
print(f"Output file: {output_file}")


