#!/bin/bash

BASE_DIR="//13_pangenoma_NOVO"

cd "$BASE_DIR" || exit

for dir in */; do

    # Skip Panaroo result directories
    if [[ "$dir" == panaroo_results_* ]]; then
        continue
    fi

    echo "========================================"
    echo "Processing: $dir"
    echo "========================================"

    cd "$dir" || continue

    files=( *.gff *.gff3 )

    valid_files=()
    for f in "${files[@]}"; do
        [ -e "$f" ] && valid_files+=("$f")
    done

    if [ ${#valid_files[@]} -eq 0 ]; then
        echo "No GFF/GFF3 files found in $dir. Skipping..."
        cd ..
        continue
    fi

    if [ ${#valid_files[@]} -lt 2 ]; then
        echo "Too few genomes (${#valid_files[@]}) in $dir. Skipping..."
        cd ..
        continue
    fi

    OUT_DIR="../panaroo_results_${dir%/}"

    echo "Running Panaroo..."

    panaroo -i "${valid_files[@]}" \
        -o "$OUT_DIR" \
        -c 0.95 \
        -f 0.85 \
        --clean-mode moderate \
        --refind_prop_match 0.5 \
        --search_radius 1000 \
        --threads 35 \
        --remove-invalid-genes

    echo "Finished processing: $dir"

    cd ..
done

echo "All directories have been processed."


