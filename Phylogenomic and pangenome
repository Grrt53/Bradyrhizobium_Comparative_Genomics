# ------------------------------------------------------------------------
# 2. MAIN FUNCTION (PARALLELIZED) WITH FIXED SEED
# ------------------------------------------------------------------------
get_pan_metrics_parallel <- function(files, base_dir) {
  
  n_cores <- min(parallel::detectCores() - 1, 50)
  cl <- makeCluster(n_cores)
  registerDoParallel(cl)
  cat("Using", n_cores, "cores for parallel processing...\n")
  
  # --- GLOBAL SEED: set ONCE before foreach.
  #     doRNG handles generating independent streams for each iteration.
  seed <- 1998
  set.seed(seed)
  
  results <- foreach(
    f = files, 
    .packages = c("pagoo", "micropan", "dplyr", "stringr"),
    .combine = function(...) {
      lists <- list(...)
      list(
        metrics = bind_rows(lapply(lists, function(x) x$metrics)),
        unique_genes = bind_rows(lapply(lists, function(x) x$unique_genes)),
        curves = bind_rows(lapply(lists, function(x) x$curves)),
        all_clusters = bind_rows(lapply(lists, function(x) x$all_clusters))
      )
    }
  ) %dorng% {
    
    # Extract species name (folder containing the CSV)
    spp <- basename(dirname(f))
    if (spp == "" || spp == "." || spp == "/") {
      rel_path <- sub(paste0(base_dir, "/"), "", f)
      spp <- strsplit(rel_path, "/")[[1]][1]
    }
    
    cat("Processing:", spp, "\n")
    
    # Initialize outputs
    metrics_out <- NULL
    unique_genes_out <- NULL
    curve_out <- NULL
    clusters_out <- NULL
    
    # Read Panaroo data
    pan_obj <- tryCatch({
      pagoo::panaroo_2_pagoo(gene_presence_absence_csv = f)
    }, error = function(e) {
      cat("Error in", spp, ":", e$message, "\n")
      return(NULL)
    })
    
    if (is.null(pan_obj)) {
      return(list(metrics = metrics_out, unique_genes = unique_genes_out, 
                  curves = curve_out, all_clusters = clusters_out))
    }
    
    # ------------------------------------------------------------
    # 1. Save gene families for this species (with category)
    # ------------------------------------------------------------
    output_dir <- dirname(f)
    
    # Get all clusters as data.frame
    clusters_df <- as.data.frame(pan_obj$clusters)
    # Add category column: core, shell, cloud
    clusters_df$category <- "cloud"  # default
    clusters_df$category[clusters_df$cluster %in% pan_obj$core_clusters$cluster] <- "core"
    clusters_df$category[clusters_df$cluster %in% pan_obj$shell_clusters$cluster] <- "shell"
    
    # Save individual file per species
    write.csv(
      clusters_df,
      file = file.path(output_dir, paste0(spp, "_gene_families.csv")),
      row.names = FALSE
    )
    
    # Add species column for the general file
    clusters_df$species <- spp
    clusters_out <- clusters_df   # to accumulate
    
    # ------------------------------------------------------------
    # 2. Main metrics (using summary_stats)
    # ------------------------------------------------------------
    pan_stats <- pan_obj$summary_stats
    
    # Alpha (power law)
    alpha <- tryCatch({
      fit <- pan_obj$pg_power_law_fit()
      attr(fit, "alpha")
    }, error = function(e) {
      cat("Error calculating alpha for", spp, ":", e$message, "\n")
      NA
    })
    
    # Fluidity
    fluidity <- tryCatch({
      micropan::fluidity(pan_obj$pan_matrix, n.sim = 500)
    }, error = function(e) {
      cat("Error calculating fluidity for", spp, ":", e$message, "\n")
      c(NA, NA)
    })
    
    # Main metrics
    metrics_out <- data.frame(
      species = spp,
      pan_n_genomes = nrow(pan_obj$organisms),
      pan_total = pan_stats[1, 2],
      core = pan_stats[2, 2],
      shell = pan_stats[3, 2],
      cloud = pan_stats[4, 2],
      alpha = alpha,
      fluidity_mean = ifelse(is.null(fluidity[1]), NA, fluidity[1]),
      fluidity_std = ifelse(is.null(fluidity[2]), NA, fluidity[2]),
      stringsAsFactors = FALSE
    )
    
    # ------------------------------------------------------------
    # 3. Unique genes per genome
    # ------------------------------------------------------------
    pan_matrix <- as.data.frame(pan_obj$pan_matrix)
    unique_genes <- rowSums(pan_matrix[, colSums(pan_matrix) == 1, drop = FALSE])
    
    unique_genes_out <- data.frame(
      genome = rownames(pan_matrix),
      species = spp,
      unique_genes = unique_genes,
      total_genes = rowSums(pan_matrix),
      perc_unique = (unique_genes / rowSums(pan_matrix)) * 100,
      stringsAsFactors = FALSE
    )
    
    # Save individual unique genes file
    write.csv(
      unique_genes_out,
      file = file.path(output_dir, paste0(spp, "_unique_genes_per_genome.csv")),
      row.names = FALSE
    )
    
    # ------------------------------------------------------------
    # 4. Accumulation curve (only if >=9 genomes)
    # ------------------------------------------------------------
    n_genomes <- nrow(pan_obj$organisms)
    if (n_genomes >= 9) {
      pan_matrix_mat <- as.matrix(pan_obj$pan_matrix)
      accum_curve <- sapply(1:n_genomes, function(k) {
        mean(replicate(500, {
          sampled <- sample(n_genomes, k)
          sum(colSums(pan_matrix_mat[sampled, , drop = FALSE]) > 0)
        }))
      })
      
      curve_out <- data.frame(
        species = spp,
        alpha = alpha,
        genomes = 1:n_genomes,
        genes = accum_curve,
        stringsAsFactors = FALSE
      )
    } else {
      cat(spp, "has only", n_genomes, "genomes. Insufficient for accumulation curve.\n")
    }
    
    # Return all elements
    list(metrics = metrics_out, 
         unique_genes = unique_genes_out, 
         curves = curve_out,
         all_clusters = clusters_out)
  }
  
  stopCluster(cl)
  return(results)
}

