    sp_total = len(sdf)
    sp_with  = int(sdf['has_nonS'].sum())
    core_id  = int(((sdf['category'] == 'core')  & sdf['has_nonS']).sum())
    shell_id = int(((sdf['category'] == 'shell') & sdf['has_nonS']).sum())
    cloud_id = int(((sdf['category'] == 'cloud') & sdf['has_nonS']).sum())
    summary_lines.append(f" {sp:<40} {sp_total:>7} {sp_with:>7} "
