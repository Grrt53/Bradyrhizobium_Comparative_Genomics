# Filtering Relevant Files 

#!/usr/bin/env python3
"""
Script to filter significant enrichments (p_adj < 0.05)
and generate a VERTICAL heatmap (core → shell → cloud) with range -5 to +5.

- Colorbar of log2 odds ratio in ALL 3 TYPES (core, shell, cloud).
- WITHOUT α gradient.
- "log2 odds ratio" vertically to the LEFT of its colorbar.
- "Species" visible in all 3 rows, NORMAL typography (not bold).
- xlabel "COG category" ONLY on cloud, NORMAL typography (not bold).
- Species with NORMAL typography, colored by α group.
- COG labels:
    * COG unique to one type  → full name in that type.
    * COG present in ≥2 types → full name ONLY in cloud
      (or in the lowest type where it appears).
    * Rest → only the letter.
- Shell and cloud COGs reordered according to CORE order.
"""

import os
import pandas as pd
import numpy as np
import matplotlib as mpl
import matplotlib.pyplot as plt
import seaborn as sns

# =============================================================================
# CONFIGURATION
# =============================================================================
INPUT_FILE = "/media/mordor/hector/brady_spp/13_pangenoma_NOVO/Results_eggnop-mapper/COG_enrichment_all_categories_with_adj.csv"
OUTPUT_CSV = "/media/mordor/hector/brady_spp/13_pangenoma_NOVO/Results_eggnop-mapper/significant_only_p_adj_0.05.csv"
OUTPUT_HEATMAP = "/media/mordor/hector/brady_spp/13_pangenoma_NOVO/Results_eggnop-mapper/fig3c_heatmap_significant_only.png"

COG_DESCRIPTIONS = {
    'A': 'RNA processing and modification',
    'B': 'Chromatin structure and dynamics',
    'C': 'Energy production and conversion',
    'D': 'Cell cycle control...', #, cell division, chromosome partitioning
    'E': 'Amino acid transport and metabolism',
    'F': 'Nucleotide transport and metabolism',
    'G': 'Carbohydrate transport and metabolism',
    'H': 'Coenzyme transport and metabolism',
    'I': 'Lipid transport and metabolism',
    'J': 'Translation, ribosomal structure and biogenesis',
    'K': 'Transcription',
    'L': 'Replication, recombination and repair',
    'M': 'Cell wall/membrane/envelope biogenesis',
    'N': 'Cell motility',
    'O': 'Posttranslational modification, protein turnover, chaperones',
    'P': 'Inorganic ion transport and metabolism',
    'Q': 'Secondary metabolites biosynthesis, transport and catabolism',
    'R': 'General function prediction only',
    'S': 'Function unknown',
    'T': 'Signal transduction mechanisms',
    'U': 'Intracellular trafficking, secretion, and vesicular transport',
    'V': 'Defense mechanisms',
    'W': 'Extracellular structures',
    'Y': 'Nuclear structure',
    'Z': 'Cytoskeleton'
}

# =============================================================================
# ALPHA GROUPS
# =============================================================================
ALPHA_GROUPS = {
    'High-α': {
        'species': ['B_sp15', 'B_denitrificans', 'B_sp148', 'B_sp150', 
        'B_sp7', 'B_sp151', 'B_sp149', 'B_sp107'],
        'color': 'darkorange',
    },
    'Intermediate-α': {
        'species': ['B_elkanii', 'B_ottawaense', 
        'B_diazoefficiens', 'B_japonicum'],
        'color': 'gold',
    },
    'Low-α': {
        'species': ['B_barranii', 'B_sp11', 'B_zhanjiangense',
                    'B_australafricanum', 'B_yuanmingense'],
        'color': 'green',
    },
}

# =============================================================================
# LOADING AND FILTERING
# =============================================================================
print("Loading file...")
df = pd.read_csv(INPUT_FILE)

df_sig = df.dropna(subset=['p_adj_Bonf', 'log2_odds']).copy()
df_sig = df_sig[df_sig['p_adj_Bonf'] < 0.05]

print(f"Total significant tests (p_adj_Bonf < 0.05): {len(df_sig)}")

df_sig.to_csv(OUTPUT_CSV, index=False)
print(f"File saved: {OUTPUT_CSV}")

# =============================================================================
# SPECIES ORDER BY ALPHA GROUP
# =============================================================================
present_species = set(df_sig['species'].unique())

species_order = []
species_color = {}
for group_name, info in ALPHA_GROUPS.items():
    for sp in info['species']:
        species_color[sp] = info['color']
        if sp in present_species:
            species_order.append(sp)

unclassified = sorted(present_species - set(species_order))
for sp in unclassified:
    species_color[sp] = 'black'
species_order += unclassified

if unclassified:
    print("WARNING: species without assigned α group:", unclassified)

# =============================================================================
# COG ORDER ACCORDING TO CORE
# =============================================================================
categories = ['core', 'shell', 'cloud']

core_df = df_sig[df_sig['category'] == 'core']
if not core_df.empty:
    core_pivot = core_df.pivot(index='species', columns='COG', values='log2_odds')
    cog_order_core = core_pivot.mean(axis=0).sort_values(ascending=False).index.tolist()
else:
    cog_order_core = []

all_cogs = sorted(df_sig['COG'].unique())
cog_order = cog_order_core + [c for c in all_cogs if c not in cog_order_core]

print(f"COG order (according to core): {cog_order}")

# =============================================================================
# IN WHICH TYPE TO SHOW THE FULL NAME OF EACH COG?
# =============================================================================
cog_presence = {c: set() for c in cog_order}
for cat in categories:
    for c in df_sig[df_sig['category'] == cat]['COG'].unique():
        if c in cog_presence:
            cog_presence[c].add(cat)

cog_full_name_in = {}
for c, types in cog_presence.items():
    if len(types) == 1:
        cog_full_name_in[c] = next(iter(types))
    else:
        for t in ['cloud', 'shell', 'core']:
            if t in types:
                cog_full_name_in[c] = t
                break

print("COGs with full name by category:")
for cat in categories:
    cogs_here = [c for c, t in cog_full_name_in.items() if t == cat]
    print(f"  {cat}: {cogs_here}")

# =============================================================================
# VERTICAL HEATMAP (core → shell → cloud)
# =============================================================================
norm = mpl.colors.Normalize(vmin=-5, vmax=5)
cmap = plt.cm.RdBu_r

fig = plt.figure(figsize=(15, 22))

outer = fig.add_gridspec(
    3, 2,
    width_ratios=[40, 1],
    wspace=0.06,
    hspace=0.45,
)

for idx, cat in enumerate(categories):
    # -------------------------------------------------------------------
    # Heatmap
    # -------------------------------------------------------------------
    ax = fig.add_subplot(outer[idx, 0])
    cat_df = df_sig[df_sig['category'] == cat]

    if not cat_df.empty:
        pivot = cat_df.pivot(index='species', columns='COG', values='log2_odds')
        pivot = pivot.reindex(index=species_order).fillna(0)

        available_cogs = [c for c in cog_order if c in pivot.columns]
        pivot = pivot[available_cogs]

        sns.heatmap(
            pivot, ax=ax, cmap=cmap, center=0, norm=norm,
            cbar=False, linewidths=0.5, vmin=-5, vmax=5,
        )
        ax.set_title(f'{cat.capitalize()} enrichment', fontsize=14, pad=10)
        # "Species" in NORMAL typography (not bold)
        ax.set_ylabel('Species', fontsize=13, fontweight='normal')

        # ---- COG labels ----
        labels = []
        for c in pivot.columns:
            if cog_full_name_in.get(c) == cat:
                labels.append(f"{c}: {COG_DESCRIPTIONS.get(c, '')}")
            else:
                labels.append(str(c))

        if cat == 'cloud':
            ax.set_xticklabels(labels, rotation=45, ha='right', fontsize=12) #9
            # "COG category" in NORMAL typography (not bold)
            ax.set_xlabel('COG category', fontsize=13, fontweight='normal',
                          labelpad=14)
        else:
            ax.set_xticklabels(labels, rotation=45, ha='right', fontsize=12) #9
            ax.set_xlabel('')

        # Species: NORMAL typography, colored by α group
        for label in ax.get_yticklabels():
            sp = label.get_text()
            label.set_color(species_color.get(sp, 'black'))
            label.set_fontweight('normal')
            label.set_fontsize(11)
    else:
        ax.text(0.5, 0.5, 'No significant data',
                ha='center', va='center', transform=ax.transAxes)
        ax.set_title(f'{cat.capitalize()} - No data')
        ax.set_ylabel('Species', fontsize=12, fontweight='normal')
        ax.set_xlabel('')
        if cat == 'cloud':
            ax.set_xlabel('COG category', fontsize=14, fontweight='normal',
                          labelpad=14)

    # -------------------------------------------------------------------
    # Colorbar log2 odds ratio PER ROW (core, shell and cloud)
    # -------------------------------------------------------------------
    cbar_ax = fig.add_subplot(outer[idx, 1])
    sm = mpl.cm.ScalarMappable(cmap=cmap, norm=norm)
    sm.set_array([])
    cbar = fig.colorbar(sm, cax=cbar_ax)
    cbar.ax.yaxis.set_label_position('left')   # label on the left
    cbar.ax.yaxis.tick_right()                 # numbers on the right
    cbar.set_label('log2 odds ratio', fontsize=11, labelpad=8)
    cbar.ax.tick_params(labelsize=9)

# ---------------------------------------------------------------------------
plt.savefig(OUTPUT_HEATMAP, dpi=350, bbox_inches='tight')
plt.close()
print(f"Heatmap saved: {OUTPUT_HEATMAP}")
print("\nProcess completed!")







