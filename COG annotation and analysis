df_expanded.rename(columns={'COG_letters': 'COG'}, inplace=True)
df_expanded.to_csv(
    os.path.join(OUTPUT_DIR, "gene_families_expanded_COG.csv"), index=False
)
print(f"Expanded dataframe: {len(df_expanded)} rows")


# =============================================================================
# DETAILED STATISTICAL SUMMARY
# =============================================================================
print("\nGenerating detailed statistical summary...")

df_fam['has_nonS'] = df_fam['COG_letters'].apply(lambda x: any(l != 'S' for l in x))

W = 78
def sep(ch='='): return ch * W

summary_lines = []

summary_lines.append(sep())
summary_lines.append(" SUMMARY STATISTICS — COG ENRICHMENT".center(W))
summary_lines.append(sep())
summary_lines.append(f" Date:               {pd.Timestamp.now():%Y-%m-%d %H:%M:%S}")
summary_lines.append(f" Output directory:   {OUTPUT_DIR}")
summary_lines.append(f" COG mode:           "
                     f"{'PRIMARY (1 COG/family, Option A)' if USE_PRIMARY_COG_ONLY else 'MULTI-COG per family'}")
summary_lines.append(f" Exclude 'S':        {EXCLUDE_S_FROM_ENRICHMENT}")
summary_lines.append(f" 'S*' annotations with functional letters: "
                     f"{sum(s_prefixed.values())}")
summary_lines.append("")

summary_lines.append(sep('-'))
summary_lines.append(" 1. GLOBAL")
summary_lines.append(sep('-'))
global_total   = len(df_fam)
global_with    = int(df_fam['has_nonS'].sum())
global_without = global_total - global_with
summary_lines.append(f" Total families (species-cluster): {global_total}")
summary_lines.append(f"   With annotation (≥1 COG ≠ S):    {global_with}")
summary_lines.append(f"   Without annotation (only S):     {global_without}")
summary_lines.append("")

for cat in CATEGORIES:
    cdf = df_fam[df_fam['category'] == cat]
    c_with = int(cdf['has_nonS'].sum())
