# =============================================================================
# HELPER FUNCTIONS
# =============================================================================
def parse_eggnog(eggnog_path):
    """
    Read eggNOG-mapper file and return {query: COG string}.
    Column 7 (index 6) contains the COG letters.
    Null values or '-' -> 'S'.
    """
    if not os.path.exists(eggnog_path):
        return {}
    try:
        df = pd.read_csv(eggnog_path, sep='\t', header=None, comment='#',
                         dtype=str, na_values=['-', '', 'NaN'])
        if df.empty:
            return {}
        if df.shape[1] < 7:
            print(f"  Warning: {eggnog_path} has <7 columns. Assigning 'S'.",
                  file=sys.stderr)
            return {row[0]: 'S' for row in df.values}
        queries = df.iloc[:, 0].values
        cogs    = df.iloc[:, 6].values
        cogs    = ['S' if (pd.isna(x) or x == '-') else str(x).strip() for x in cogs]
        return dict(zip(queries, cogs))
    except Exception as e:
        print(f"Error reading {eggnog_path}: {e}", file=sys.stderr)
        return {}


def split_cog(cog_str):
    """
    'CE' -> ['C','E'] (only valid letters from dictionary).
    Empty -> ['S'].
    """
    if pd.isna(cog_str) or cog_str == '':
        return ['S']
    valid = [ch for ch in str(cog_str).strip() if ch in COG_DESCRIPTIONS]
    return valid if valid else ['S']


def primary_cog(cog_str):
    """
    OPTION A — Returns the first FUNCTIONAL COG letter (≠ 'S') if it exists.

      "SE" -> 'E'      (before fix: 'S' -> silent loss)
      "SG" -> 'G'
      "ES" -> 'E'
      "S"  -> 'S'      (correct fallback: no functional letter)
      "SX" -> 'S'      ('X' is not in COG_DESCRIPTIONS)
      ""   -> 'S'

    This is consistent with the external loop filter, which already discards
    cog_str == 'S' exactly. If a family has "SE", it means it has
    a real functional annotation ('E') and should not fall back to 'S'.
    """
    letters = [c for c in split_cog(cog_str) if c != 'S']
    return letters[0] if letters else 'S'


def build_cluster_to_queries(mapping, clusters_sp):
    """
    FIX FOR PREFIX MATCHING.

    Assigns each eggNOG query to EXACTLY ONE cluster:
    the most specific (= the longest) that matches.

    Avoids double counting when one cluster is a prefix of another:
      cluster "gene_1"   -> query "gene_1_2_3" matches
      cluster "gene_1_2" -> query "gene_1_2_3" matches
      With this function the query is assigned ONLY to cluster "gene_1_2".
    """
    clusters_sorted = sorted(clusters_sp, key=len, reverse=True)
    c2q = {c: [] for c in clusters_sp}
    for query in mapping:
        for cluster in clusters_sorted:
            if query == cluster or query.startswith(cluster + '_'):
                c2q[cluster].append(query)
                break   # <-- do NOT keep searching
    return c2q


# =============================================================================
# STATISTICAL FUNCTION
# =============================================================================
def fisher_log2_or(a, b, c, d):
    """
    Returns (log2OR, p_fisher).

    - If any marginal = 0 -> (NaN, NaN)  (OR not defined).
    - p_fisher: Fisher exact two-sided on the ORIGINAL table.
    - log2OR  : Haldane-Anscombe (+0.5 to the 4 cells) ONLY if any cell = 0.
    - Final clipping of log2OR to [-10, 10] for graphical stability.
    """
    global FISHER_ERROR_COUNT
    a, b, c, d = int(a), int(b), int(c), int(d)

    # 1) Degenerate table -> NaN
    if (a + b) == 0 or (c + d) == 0 or (a + c) == 0 or (b + d) == 0:
        return np.nan, np.nan

    # 2) p-value on the original table
    try:
        _, p = fisher_exact([[a, b], [c, d]], alternative='two-sided')
        p = float(p)
        if not np.isfinite(p):
            p = 1.0
    except Exception as e:
        FISHER_ERROR_COUNT += 1
        print(f"⚠️ Fisher failed for table [[{a},{b}],[{c},{d}]]: {e}",
              file=sys.stderr)
        return np.nan, np.nan

    # 3) log2(OR) with Haldane-Anscombe ONLY if there are zeros
    if min(a, b, c, d) == 0:
        a2, b2, c2, d2 = a + 0.5, b + 0.5, c + 0.5, d + 0.5
    else:
        a2, b2, c2, d2 = float(a), float(b), float(c), float(d)

    log2or = float(np.log2((a2 * d2) / (b2 * c2)))
    log2or = float(np.clip(log2or, -10.0, 10.0))

    return log2or, p


