print(f"Total annotations exactly 'S': {s_total}")
print(f"'S*' annotations with additional letters: {sum(s_prefixed.values())}")
if s_prefixed:
    print("Top 20 'S*' patterns found:")
    for k, v in s_prefixed.most_common(20):
        # Does it have any functional letter (≠ 'S')?
        extras = [c for c in k if c in COG_DESCRIPTIONS and c != 'S']
        tag = f"-> corrected primary: '{extras[0]}'" if extras else "-> only 'S'"
        print(f"    {k:<8} {v:>6}   {tag}")
else:
    print("No annotations of type 'SE', 'SG', etc. were found.")
print("=" * 78)
print()


# =============================================================================
# COG ASSIGNMENT PER (SPECIES, CLUSTER) — NO DOUBLE COUNTING
# =============================================================================
print("Assigning COG to each species-cluster combination...")

species_cluster_cogs = {sp: {} for sp in species_list}

for sp in species_list:
    mapping = species_mappings.get(sp, {})
    if not mapping:
        continue

    clusters_sp = set(df_fam[df_fam['species'] == sp]['cluster'])
    c2q = build_cluster_to_queries(mapping, clusters_sp)

    for cluster in clusters_sp:
        letters = []
        for query in c2q[cluster]:
            cog_str = mapping[query]
            if cog_str and cog_str not in ['-', 'S'] and not pd.isna(cog_str):
                if USE_PRIMARY_COG_ONLY:
                    letters.append(primary_cog(cog_str))   # <-- Option A
                else:
                    letters.extend(split_cog(cog_str))
        if not letters:
            letters = ['S']
        species_cluster_cogs[sp][cluster] = sorted(set(letters))


def get_cog_letters(row):
    return species_cluster_cogs.get(row['species'], {}).get(row['cluster'], ['S'])


df_fam['COG_letters'] = df_fam.apply(get_cog_letters, axis=1)

# Audit: one row per cluster with its assigned COGs
audit_rows = []
for _, r in df_fam.iterrows():
    audit_rows.append({
        'species':     r['species'],
        'cluster':     r['cluster'],
        'category':    r['category'],
        'COG_letters': ';'.join(r['COG_letters']),
        'n_COGs':      len(r['COG_letters']),
    })
pd.DataFrame(audit_rows).to_csv(
    os.path.join(OUTPUT_DIR, "cluster_COG_assignment.csv"), index=False
)

# Expand: one row per COG letter
