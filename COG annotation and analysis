plt.savefig(os.path.join(OUTPUT_DIR, 'fig3a_pangenome_composition.png'), dpi=300)
plt.close()


# =============================================================================
# FIGURE 3C: COG ENRICHMENT
# =============================================================================
print("\nGenerating Figure 3C (COG enrichment)...")

cogs_for_enrich = sorted(set(df_expanded['COG']))
if EXCLUDE_S_FROM_ENRICHMENT:
    cogs_for_enrich = [c for c in cogs_for_enrich if c != 'S']
print(f"COGs analyzed: {len(cogs_for_enrich)} -> {cogs_for_enrich}")

n_tests        = 0
bonf_threshold = np.nan
df_enrich      = None
cross          = None

if cogs_for_enrich:
    enrichment_results = []
    for sp in species_list:
        sp_df        = df_fam[df_fam['species'] == sp]
        all_clusters = set(sp_df['cluster'])
        n_total      = len(all_clusters)

        # Precompute clusters with each COG
        cog_clusters = {}
        for cog in cogs_for_enrich:
            cog_clusters[cog] = set(
                df_expanded[(df_expanded['species'] == sp) &
                            (df_expanded['COG'] == cog)]['cluster']
            )

        for cog in cogs_for_enrich:
            for cat in CATEGORIES:
                cat_clusters    = set(sp_df.loc[sp_df['category'] == cat, 'cluster'])
                noncat_clusters = all_clusters - cat_clusters

                a = len(cat_clusters & cog_clusters[cog])
                b = len(cat_clusters) - a
                c = len(noncat_clusters & cog_clusters[cog])
                d = len(noncat_clusters) - c

                log2_or, p = fisher_log2_or(a, b, c, d)

                enrichment_results.append({
                    'species':       sp,
                    'COG':           cog,
                    'category':      cat,
                    'a':             a,
                    'b':             b,
                    'c':             c,
                    'd':             d,
                    'n_category':    a + b,
                    'n_noncategory': c + d,
                    'n_COG_total':   a + c,
                    'n_total':       n_total,
                    'log2OR':        log2_or,
                    'p_fisher':      p,
                })

    df_enrich      = pd.DataFrame(enrichment_results)
    n_tests        = len(df_enrich)
    bonf_threshold = ALPHA / n_tests
    print(f"Tests: {n_tests}   Bonferroni threshold: {bonf_threshold:.3e}")

    # --- Multiple adjustments (Bonferroni + BH), excluding NaN ---
    valid_mask = df_enrich['p_fisher'].notna()
    pv         = df_enrich.loc[valid_mask, 'p_fisher'].values

    p_bonf_all = np.full(len(df_enrich), np.nan)
    p_bh_all   = np.full(len(df_enrich), np.nan)

    if len(pv) > 0:
        p_bonf_all[valid_mask] = np.minimum(pv * n_tests, 1.0)
        _, p_bh_v, _, _ = multipletests(pv, method='fdr_bh')
        p_bh_all[valid_mask] = p_bh_v

    df_enrich['p_adj_Bonf']     = p_bonf_all
    df_enrich['significant']    = df_enrich['p_fisher'] < bonf_threshold
    df_enrich['p_adj_BH']       = p_bh_all
    df_enrich['significant_BH'] = df_enrich['p_adj_BH'] < ALPHA

    df_enrich = df_enrich[[
        'species', 'COG', 'category',
        'a', 'b', 'c', 'd',
        'n_category', 'n_noncategory', 'n_COG_total', 'n_total',
        'log2OR', 'p_fisher',
        'p_adj_Bonf', 'significant',
        'p_adj_BH',   'significant_BH'
    ]]

    out_stats = os.path.join(OUTPUT_DIR, "COG_enrichment_all_categories_with_adj.csv")
    df_enrich.to_csv(out_stats, index=False)
    print(f"General table saved: {out_stats}")

    n_sig_bonf = int(df_enrich['significant'].sum())
    n_sig_bh   = int(df_enrich['significant_BH'].sum())
    print(f"Significant Bonferroni: {n_sig_bonf}")
    print(f"Significant BH (ref.):  {n_sig_bh}")

    # --- Cross-species summary ---
    cross = df_enrich.groupby(['COG', 'category']).agg(
        n_species_measured=('log2OR', 'count'),
        mean_LOR=('log2OR', 'mean'),
        median_LOR=('log2OR', 'median'),
        sd_LOR=('log2OR', 'std'),
        n_sig_Bonf=('significant', 'sum'),
        n_sig_BH=('significant_BH', 'sum'),
    ).reset_index()
    cross['frac_sig_Bonf'] = cross['n_sig_Bonf'] / cross['n_species_measured']
    cross['frac_sig_BH']   = cross['n_sig_BH']   / cross['n_species_measured']
    cross['abs_mean_LOR']  = cross['mean_LOR'].abs()
    cross.to_csv(
        os.path.join(OUTPUT_DIR, "COG_enrichment_cross_species_summary.csv"),
        index=False
    )

    # --- Heatmap with asterisks ---
    print("Generating heatmap...")
    fig, axes = plt.subplots(1, len(CATEGORIES),
                             figsize=(8 * len(CATEGORIES), 8),
                             sharey=True)
    if len(CATEGORIES) == 1:
        axes = [axes]

    all_vals = df_enrich['log2OR'].dropna().values
    if len(all_vals) > 0:
        vmax = max(np.percentile(np.abs(all_vals), 95), 1.0)
    else:
        vmax = 5.0
    vmin = -vmax

    for idx, cat in enumerate(CATEGORIES):
        sub     = df_enrich[df_enrich['category'] == cat]
        piv_lor = sub.pivot(index='species', columns='COG', values='log2OR')
        piv_sig = sub.pivot(index='species', columns='COG', values='significant')
        piv_lor = piv_lor.reindex(columns=ALL_COG_LETTERS)
        piv_sig = piv_sig.reindex(columns=ALL_COG_LETTERS, fill_value=False)

        mask   = piv_lor.isna()
        filled = piv_lor.fillna(0)

        if idx == 0:
            order = filled.mean(axis=0).sort_values(ascending=False).index
        filled  = filled[order]
        piv_sig = piv_sig[order]
        mask    = mask[order]

        sns.heatmap(filled, ax=axes[idx], cmap='RdBu_r', center=0,
                    cbar_kws={'label': 'log2 odds ratio'},
                    linewidths=0.5, vmin=vmin, vmax=vmax, mask=mask)

        for i in range(piv_sig.shape[0]):
            for j in range(piv_sig.shape[1]):
                if piv_sig.iloc[i, j]:
                    axes[idx].text(j + 0.5, i + 0.5, '*', ha='center',
                                   va='center', fontsize=11,
                                   fontweight='bold')

        axes[idx].set_title(f'{cat.capitalize()} enrichment', fontsize=14)
        axes[idx].set_xlabel('COG category')
        axes[idx].set_ylabel('Species' if idx == 0 else '')
        labels = [f"{c}: {COG_DESCRIPTIONS.get(c, '')[:20]}"
                  for c in filled.columns]
        axes[idx].set_xticklabels(labels, rotation=45, ha='right', fontsize=8)

    fig.suptitle(
        f"COG enrichment (* = Fisher p < {bonf_threshold:.1e}, "
        f"Bonferroni FWER < {ALPHA})", y=1.02
    )
