#!/usr/bin/env python3

import os
import glob
import csv
from collections import defaultdict, Counter

# Required for reading ODS
import pandas as pd

# -------------------- Configuration --------------------
INPUT_DIR = "/XXXX/X/XX/X/Xgenes_gly_1/usearch/"
REFERENCE_FILE = "/XXXX/XX/X/XXdocuments_brady/base_limpio_original_NUEVO.ods"
OUTPUT_MATRIX = "gene_presence_matrix.csv"
OUTPUT_DUPLICATES = "duplicated_genes.txt"
# -------------------------------------------------------

def load_gene_mapping(ods_file):
    """
    Reads the ODS reference file and returns a dictionary:
        UniProt accession -> gene name (first word of Gene column)
    """
    if not os.path.isfile(ods_file):
        raise FileNotFoundError(f"Reference file not found: {ods_file}")

    # Read the first sheet
    df = pd.read_excel(ods_file, engine='odf', dtype=str)
    # Expected columns: Cod_Ref, Gene, Type
    mapping = {}
    for _, row in df.iterrows():
        acc = str(row['Cod_Ref']).strip()
        gene_full = str(row['Gene']).strip()
        # Take the first word as the gene name
        gene = gene_full.split()[0] if gene_full else ''
        if acc and gene:
            mapping[acc] = gene
    return mapping

def extract_uniprot_acc(target):
    """
    Extract UniProt accession from a Target string like:
        tr|Q9AQ08|Q9AQ08_BRASW ...
        sp|P05406|FIXR_BRADU ...
    Returns the second field after splitting by '|'.
    If format is unexpected, returns None.
    """
    parts = target.split('|')
    if len(parts) >= 2:
        return parts[1]
    return None

def process_tsv(file_path, mapping):
    """
    Reads a TSV file, counts mapped genes per genome.
    Returns a Counter object with gene counts.
    Also returns a list of duplicated genes (count>1) for reporting.
    """
    counter = Counter()
    duplicates_in_file = []
    with open(file_path, 'r') as f:
        reader = csv.DictReader(f, delimiter='\t')
        for row in reader:
            target = row['Target']
            acc = extract_uniprot_acc(target)
            if acc and acc in mapping:
                gene = mapping[acc]
                counter[gene] += 1
    # Identify duplicates (count > 1) in this genome
    for gene, count in counter.items():
        if count > 1:
            duplicates_in_file.append((gene, count))
    return counter, duplicates_in_file

def main():
    print("Loading gene mapping from ODS...")
    mapping = load_gene_mapping(REFERENCE_FILE)
    print(f"Loaded {len(mapping)} mappings.")

    # Find all TSV files
    pattern = os.path.join(INPUT_DIR, "*_gly_novo.tsv")
    files = glob.glob(pattern)
    if not files:
        print(f"No files found matching {pattern}")
        return
    print(f"Found {len(files)} files to process.")

    genome_counts = {}          # genome -> Counter(gene -> count)
    all_duplicates = []         # list of tuples (genome, gene, count)

    for file_path in files:
        basename = os.path.basename(file_path)
        genome = basename[:15]   # first 15 characters
        print(f"Processing {genome} ...")
        counts, dups = process_tsv(file_path, mapping)
        genome_counts[genome] = counts
        for gene, count in dups:
            all_duplicates.append((genome, gene, count))

    # Collect all distinct genes across all genomes
    all_genes = set()
    for counts in genome_counts.values():
        all_genes.update(counts.keys())
    all_genes = sorted(all_genes)

    # Write gene presence matrix (CSV)
    with open(OUTPUT_MATRIX, 'w', newline='') as f:
        writer = csv.writer(f)
        header = ['genome'] + all_genes
        writer.writerow(header)
        for genome in sorted(genome_counts.keys()):
            row = [genome]
            counts = genome_counts[genome]
            for gene in all_genes:
                row.append(counts.get(gene, 0))
            writer.writerow(row)
    print(f"Gene presence matrix written to {OUTPUT_MATRIX}")

    # Write duplicates report
    if all_duplicates:
        with open(OUTPUT_DUPLICATES, 'w') as f:
            f.write("genome\tgene\tcount\n")
            for genome, gene, count in all_duplicates:
                f.write(f"{genome}\t{gene}\t{count}\n")
        print(f"Duplicates report written to {OUTPUT_DUPLICATES}")
    else:
        print("No duplicated genes found.")

if __name__ == "__main__":
    main()


