library(tidyverse)
library(pheatmap)
library(viridis)
library(ggplot2)
library(data.table)
library(RColorBrewer)
library(gridExtra)

generate_category_analysis <- function(data, output_dir, category_name,
                                       additional_meta = NULL, all_species = NULL) {
  cat("Generating analysis for:", category_name, "\n")
  if (is.null(data) || nrow(data) == 0) {
    cat("  X  No data for this category\n")
    if (!is.null(all_species) && length(all_species) > 0) {
      presence_data <- data.frame(Species = all_species, No_hits = 0)
      fwrite(presence_data, file.path(output_dir, paste0("presence_absence_", category_name, ".csv")))
    }
    return(invisible(NULL))
  }
  
  required_cols <- c("Species", "Gene_Acronym")
  if (!all(required_cols %in% names(data))) {
    cat("  X Missing columns:", paste(setdiff(required_cols, names(data)), collapse = ", "), "\n")
    return(invisible(NULL))
  }
  
  # Presence/absence matrix
  clean_data <- data %>%
    filter(!is.na(Species), !is.na(Gene_Acronym),
           Gene_Acronym != "", Gene_Acronym != "No_hits", Gene_Acronym != "Unknown")
  
  if (nrow(clean_data) > 0 && length(all_species) > 0) {
    all_genes <- unique(clean_data$Gene_Acronym)
    presence_data <- expand.grid(Species = all_species, Gene_Acronym = all_genes) %>%
      left_join(clean_data %>% distinct(Species, Gene_Acronym) %>% mutate(present = 1),
                by = c("Species", "Gene_Acronym")) %>%
      mutate(present = ifelse(is.na(present), 0, present)) %>%
      pivot_wider(id_cols = Species, names_from = Gene_Acronym, values_from = present, values_fill = 0)
    
    fwrite(presence_data, file.path(output_dir, paste0("presence_absence_", category_name, ".csv")))
    cat("  ✓ Matrix saved:", nrow(presence_data), "species x", ncol(presence_data)-1, "genes\n")
    
    # Heatmap (only if there are at least 2 species and 2 genes)
    if (ncol(presence_data) > 2 && nrow(presence_data) >= 2) {
      tryCatch({
        hm_data <- presence_data %>% column_to_rownames("Species")
        # Ensure all columns are numeric
        hm_data <- hm_data %>% mutate(across(everything(), as.numeric))
        hm_data <- hm_data[, colSums(hm_data) > 0, drop = FALSE]
        if (ncol(hm_data) > 100) {
          top_genes <- names(sort(colSums(hm_data), decreasing = TRUE))[1:100]
          hm_data <- hm_data[, top_genes]
        }
        if (ncol(hm_data) >= 2 && nrow(hm_data) >= 2) {
          n_species <- nrow(hm_data)
          n_genes <- ncol(hm_data)
          plot_height <- max(6, n_species * 0.2 + 2)
          plot_width <- max(8, min(n_genes * 0.25, 25))
          pheatmap(as.matrix(hm_data),
                   main = category_name,
                   color = c("white", "darkblue"),
                   breaks = c(0, 0.5, 1),
                   cluster_rows = n_species > 2,
                   cluster_cols = n_genes > 2,
                   show_colnames = TRUE,
                   show_rownames = TRUE,
                   fontsize_row = max(6, min(10, 200/n_species)),
                   fontsize_col = max(6, min(9, 200/n_genes)),
                   border_color = "grey60",
                   filename = file.path(output_dir, paste0("heatmap_", category_name, ".png")),
                   width = plot_width,
                   height = plot_height,
                   silent = TRUE)
          cat("    ✓ Heatmap generated\n")
        } else {
          cat("    X  Insufficient data for heatmap (less than 2 species or 2 genes after filtering)\n")
        }
      }, error = function(e) cat("    X Heatmap error:", e$message, "\n"))
    } else {
      cat("    X  Insufficient data for heatmap (at least 2 species and 2 genes required)\n")
    }
  }
  
  # Coverage plot (if exists)
  if (all(c("QCov", "TCov") %in% names(data)) && nrow(data) > 0) {
    tryCatch({
      plot_data <- data %>% filter(!is.na(QCov), !is.na(TCov), QCov > 0, TCov > 0)
      if (nrow(plot_data) > 0) {
        p1 <- ggplot(plot_data, aes(x = QCov, y = TCov)) +
          geom_hex(bins = 30) + geom_abline(slope = 1, intercept = 0, color = "red", linetype = "dashed") +
          scale_fill_viridis_c(trans = "log10") +
          labs(title = paste("Coverage -", category_name), x = "Query Coverage (%)", y = "Target Coverage (%)") +
          theme_minimal()
        p2 <- ggplot(plot_data, aes(x = QCov)) + geom_histogram(bins = 30, fill = "steelblue") + labs(x = "Query Coverage")
        p3 <- ggplot(plot_data, aes(x = TCov)) + geom_histogram(bins = 30, fill = "darkgreen") + labs(x = "Target Coverage")
        combined <- grid.arrange(p1, arrangeGrob(p2, p3, ncol = 2), nrow = 2, heights = c(2,1))
        ggsave(file.path(output_dir, paste0("coverage_", category_name, ".png")), combined, width = 12, height = 10, dpi = 300)
        cat("    ✓ Coverage plot generated\n")
      }
    }, error = function(e) cat("    X Coverage error:", e$message, "\n"))
  }
  
  # Top genes
  if ("Gene_Acronym" %in% names(data) && nrow(data) > 0) {
    tryCatch({
      top_genes <- data %>%
        filter(!is.na(Gene_Acronym), Gene_Acronym != "", Gene_Acronym != "No_hits") %>%
        distinct(Species, Gene_Acronym) %>%
        count(Gene_Acronym, name = "Freq") %>%
        arrange(desc(Freq)) %>%
        slice_head(n = 25)
      if (nrow(top_genes) > 0) {
        p <- ggplot(top_genes, aes(x = reorder(Gene_Acronym, Freq), y = Freq)) +
          geom_col(fill = "steelblue") + geom_text(aes(label = Freq), hjust = -0.2) +
          coord_flip() + labs(title = paste("Top genes -", category_name), x = "Gene", y = "No. species") +
          theme_minimal()
        ggsave(file.path(output_dir, paste0("top_genes_", category_name, ".png")), p, width = 10, height = 8, dpi = 300)
        cat("    ✓ Top genes generated\n")
      }
    }, error = function(e) cat("    X Top genes error:", e$message, "\n"))
  }
  
  # Mechanisms
  if ("Antifungal_Mechanism" %in% names(data) && nrow(data) > 0) {
    tryCatch({
      mech_data <- data %>%
        filter(!is.na(Antifungal_Mechanism), Antifungal_Mechanism != "", Antifungal_Mechanism != "Unknown mechanism") %>%
        distinct(Species, Antifungal_Mechanism) %>%
        count(Antifungal_Mechanism, name = "Species_count")
      if (nrow(mech_data) > 0) {
        p <- ggplot(mech_data, aes(x = reorder(Antifungal_Mechanism, Species_count), y = Species_count)) +
          geom_col(fill = "darkgreen") + coord_flip() +
          labs(title = paste("Mechanisms -", category_name), x = "Mechanism", y = "No. species") +
          theme_minimal()
        ggsave(file.path(output_dir, paste0("mechanism_", category_name, ".png")), p, width = 10, height = 6, dpi = 300)
        cat("    ✓ Mechanisms plot generated\n")
      }
    }, error = function(e) cat("    X Mechanisms error:", e$message, "\n"))
  }
  
  # Gene metadata
  if (all(c("Target", "Gene_Acronym") %in% names(data)) && nrow(data) > 0) {
    gene_meta_out <- data %>%
      select(Target, Gene_Acronym, Gene_Name, Antifungal_Mechanism) %>%
      filter(!is.na(Gene_Acronym), Gene_Acronym != "", Gene_Acronym != "No_hits") %>%
      distinct()
    if (nrow(gene_meta_out) > 0) {
      fwrite(gene_meta_out, file.path(output_dir, paste0("gene_metadata_", category_name, ".csv")))
      cat("    ✓ Gene metadata saved\n")
    }
  }
  cat("  ✓ Analysis completed for:", category_name, "\n")
}

generate_summary_report <- function(data, output_dir) {
  cat("Generating summary report...\n")
  if (is.null(data) || nrow(data) == 0) {
    fwrite(data.frame(Species = character(), Type = character(), Unique_Genes = integer(), Total_Hits = integer()),
           file.path(output_dir, "analysis_summary.csv"))
    return(invisible(NULL))
  }
  required_cols <- c("Species", "Type", "Gene_Acronym")
  if (!all(required_cols %in% names(data))) {
    cat("  X Missing columns for summary\n")
    return(invisible(NULL))
  }
  
  summary_data <- data %>%
    filter(!is.na(Species), !is.na(Type)) %>%
    group_by(Species, Type) %>%
    summarise(
      Unique_Genes = n_distinct(Gene_Acronym[!is.na(Gene_Acronym) & Gene_Acronym != "No_hits" & Gene_Acronym != ""]),
      Total_Hits = n(),
      .groups = "drop"
    ) %>%
    arrange(desc(Total_Hits))
  fwrite(summary_data, file.path(output_dir, "analysis_summary.csv"))
  
  if (nrow(summary_data) > 0) {
    plot_data <- summary_data
    if (n_distinct(plot_data$Species) > 30) {
      top_species <- plot_data %>% group_by(Species) %>% summarise(Total = sum(Total_Hits)) %>% slice_max(Total, n = 30) %>% pull(Species)
      plot_data <- filter(plot_data, Species %in% top_species)
    }
    p <- ggplot(plot_data, aes(x = reorder(Species, Total_Hits), y = Total_Hits, fill = Type)) +
      geom_col(position = position_dodge(preserve = "single")) +
      coord_flip() +
      labs(title = "Summary by species", x = "Species", y = "Total hits") +
      theme_minimal() +
      theme(legend.position = "bottom")
    ggsave(file.path(output_dir, "summary_by_category.png"), p, width = 14, height = max(6, n_distinct(plot_data$Species)*0.2), dpi = 300)
    
    # Overall top species
    top_species_all <- summary_data %>% group_by(Species) %>% summarise(Total = sum(Total_Hits)) %>% slice_max(Total, n = 20)
    p2 <- ggplot(top_species_all, aes(x = reorder(Species, Total), y = Total)) +
      geom_col(fill = "steelblue") + geom_text(aes(label = Total), hjust = -0.2) +
      coord_flip() + labs(title = "Top 20 species with most hits", x = "Species", y = "Total hits") +
      theme_minimal()
    ggsave(file.path(output_dir, "top_species_summary.png"), p2, width = 10, height = 8, dpi = 300)
    cat("  ✓ Summary plots generated\n")
  }
}

