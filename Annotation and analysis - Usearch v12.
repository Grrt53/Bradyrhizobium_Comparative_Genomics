# ========== HELPER FUNCTIONS ==========
# Load species metadata (file with ID and Species columns)
read_species_metadata <- function(path) {
  meta <- read_ods(path, sheet = 1)
  # We assume the first two columns are ID and Species
  colnames(meta)[1:2] <- c("ID", "Species")
  meta <- meta %>%
    mutate(
      Genome_ID = str_extract(ID, "GC[FA]_[0-9]+\\.[0-9]+"),
      Species = trimws(as.character(Species))
    ) %>%
    filter(!is.na(Species) & Species != "") %>%
    distinct(Genome_ID, .keep_all = TRUE)
  cat("✓ Species metadata loaded:", nrow(meta), "genomes\n")
  return(meta)
}

# Load gene metadata (base_limpio.ods: Cod_Ref, Gene, Type)
load_gene_metadata <- function(path) {
  if (!file.exists(path)) {
    cat("X  File not found:", path, "\n")
    return(NULL)
  }
  meta <- read_ods(path, sheet = 1)
  # Assign names according to observed columns
  names(meta)[1:3] <- c("Cod_Ref", "Gene_Acronym", "Antifungal_Mechanism")
  meta <- meta %>%
    filter(!is.na(Cod_Ref) & Cod_Ref != "") %>%
    distinct(Cod_Ref, .keep_all = TRUE) %>%
    mutate(
      Gene_Acronym = ifelse(is.na(Gene_Acronym) | Gene_Acronym == "", Cod_Ref, Gene_Acronym),
      Antifungal_Mechanism = ifelse(is.na(Antifungal_Mechanism) | Antifungal_Mechanism == "",
                                    "Unknown mechanism", Antifungal_Mechanism),
      Gene_Name = Gene_Acronym  # optional
    )
  cat("✓ Gene metadata loaded:", nrow(meta), "genes\n")
  return(meta)
}

# Extract Cod_Ref from Target field (robust)
extract_cod_ref <- function(target) {
  if (is.na(target) || target == "") return(NA_character_)
  # Common patterns
  if (str_detect(target, "^[a-z]{2,3}\\|[A-Z0-9]+\\|")) {
    ref <- str_extract(target, "(?<=^[a-z]{2,3}\\|)[A-Z0-9]+(?=\\|)")
    if (!is.na(ref)) return(ref)
  }
  if (str_detect(target, "^>[A-Z0-9]+\\.\\d+")) {
    ref <- str_extract(target, "(?<=^>)[A-Z0-9]+(?=\\.\\d+)")
    if (!is.na(ref)) return(ref)
  }
  ref <- str_extract(target, "[A-Z][A-Z0-9]{4,9}")
  if (!is.na(ref)) return(ref)
  ref <- str_extract(target, "[A-Za-z0-9_]+")
  return(ref)
}

# Read USEARCH TSV files
read_ush_results <- function(dir_path) {
  files <- list.files(dir_path, pattern = "\\.tsv$", full.names = TRUE)
  if (length(files) == 0) return(data.frame())
  
  process_file <- function(f) {
    genome_id <- str_extract(basename(f), "GC[FA]_[0-9]+\\.[0-9]+")
    if (is.na(genome_id)) return(data.frame())
    dt <- fread(f, sep = "\t", header = TRUE, na.strings = c("", "NA"), 
                colClasses = "character", fill = TRUE)
    if (nrow(dt) == 0) return(data.frame())
    num_cols <- intersect(c("PctID", "QCov", "TCov", "AlnLen", "QLen", "TLen", "Evalue"), names(dt))
    dt[, (num_cols) := lapply(.SD, function(x) as.numeric(gsub(",", ".", x))), .SDcols = num_cols]
    dt <- dt[QCov >= 50 & TCov >= 50 & PctID >= 60 & Evalue <= 1e-5]
    if (nrow(dt) == 0) return(data.frame())
    dt[, Genome_ID := genome_id]
    dt[, Type := "Antifungal_Genes"]
    return(dt)
  }
  
  results <- future_map_dfr(files, process_file, .progress = TRUE)
  return(results)
}

