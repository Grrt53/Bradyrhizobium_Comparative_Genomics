#!/bin/bash
set -euo pipefail

# ========== CONFIGURATION ==========
PROJECT_DIR="/XXXXX/XXXXX/XXXX/brady_spp"
FAA_DIR="$PROJECT_DIR/8_brady_faa"
BASE_DB="XXXXXX/XXXXX/XXXX/data_usearch/gly_novo.udb"
# File with Genome -> Species correspondence (REQUIRED!)
SPECIES_METADATA="/XXXXX/X//X/XX/X//genome_species_total_ok_nuevo.ods"
# File with gene metadata (Cod_Ref, Gene, Type)
GENE_METADATA="XXXX/XXXXX/XXXXXX/base_limpio_original_NUEVO.ods"
OUT_DIR="/XXXX/XXXXX/XXXXX/12_results_bases_datos/genes_gly_2"
R_SCRIPT="/XXXXXX/XXXXX/XXXXX/analysis_only_IMPORTA_FINAL.R"
VIS_SCRIPT="/XXXXX/XXXXX/XXXXX/XXXXXX/visualisation_functions_IMPORTA_FINAL.R"
LOG_DIR="$OUT_DIR/logs"
TEMP_DIR="$OUT_DIR/temp"

# ========== INITIALIZATION ==========
echo "=== GENE ANALYSIS PIPELINE (BASE: importa_brady) ==="
echo "Start date: $(date '+%Y-%m-%d %H:%M:%S')"
mkdir -p "$OUT_DIR/usearch" "$OUT_DIR/r_results" "$LOG_DIR" "$TEMP_DIR"
export LC_NUMERIC="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# ========== HELPER FUNCTIONS ==========
get_genome_id() {
    local filename=$(basename "$1")
    local genome_id=$(echo "$filename" | grep -o 'GC[FA]_[0-9]\+\.[0-9]\+')
    if [ -z "$genome_id" ]; then
        genome_id=$(basename "$filename" .faa)
        echo "WARNING: Non-standard ID in $filename, using: $genome_id" >&2
    fi
    echo "$genome_id"
}

check_environment() {
    echo "=== CHECKING ENVIRONMENT ==="
    for cmd in usearch12 Rscript parallel; do
        if ! command -v $cmd &>/dev/null; then
            echo "ERROR: Command not found: $cmd"
            exit 1
        fi
    done
    [ ! -d "$FAA_DIR" ] && { echo "X $FAA_DIR does not exist"; exit 1; }
    [ ! -f "$BASE_DB" ] && { echo "X Database does not exist: $BASE_DB"; exit 1; }
    [ ! -f "$SPECIES_METADATA" ] && { echo "X Species metadata does not exist: $SPECIES_METADATA"; exit 1; }
    [ ! -f "$GENE_METADATA" ] && { echo "X Gene metadata does not exist: $GENE_METADATA"; exit 1; }
    [ ! -f "$R_SCRIPT" ] && { echo "X R script does not exist: $R_SCRIPT"; exit 1; }
    [ ! -f "$VIS_SCRIPT" ] && { echo "X Visualization script does not exist: $VIS_SCRIPT"; exit 1; }
    local faa_count=$(find "$FAA_DIR" -name '*.faa' -type f | wc -l)
    [ "$faa_count" -eq 0 ] && { echo "X No .faa files in $FAA_DIR"; exit 1; }
    echo "✓ Environment verified: $faa_count .faa files"
}

# ========== USEARCH PROCESSING ==========
process_sample() {
    local faa_file="$1"
    local genome_id=$(get_genome_id "$faa_file")
    local log_file="$LOG_DIR/${genome_id}.log"
    local db_name=$(basename "$BASE_DB" .udb)   # importa_brady
    local output_raw="$TEMP_DIR/${genome_id}_${db_name}_raw.txt"
    local output_final="$OUT_DIR/usearch/${genome_id}_${db_name}.tsv"

    echo "Processing $genome_id" >> "$log_file"
    
    if ! usearch12 -usearch_global "$faa_file" \
        -db "$BASE_DB" \
        -id 0.6 -query_cov 0.5 -target_cov 0.5 \
        -strand plus -threads 2 -maxhits 1 -top_hits_only \
        -userout "$output_raw" \
        -userfields "query+target+alnlen+ql+tl+id+evalue" \
        >> "$log_file" 2>&1; then
        echo "X Error in usearch for $genome_id" >> "$log_file"
        printf "Query\tTarget\tAlnLen\tQLen\tTLen\tPctID\tEvalue\tQCov\tTCov\n" > "$output_final"
        return 1
    fi

    if [[ -s "$output_raw" ]]; then
        awk -F"\t" -v OFS="\t" '
        BEGIN { print "Query","Target","AlnLen","QLen","TLen","PctID","Evalue","QCov","TCov" }
        NR>0 && NF>=7 {
            gsub(/[[:space:]]+$/,"",$1); gsub(/[[:space:]]+$/,"",$2)
            gsub(",",".",$3); gsub(",",".",$4); gsub(",",".",$5); gsub(",",".",$6); gsub(",",".",$7)
            alnlen=$3+0; qlen=$4+0; tlen=$5+0; pctid=$6+0; evalue=$7+0
            if (qlen>0) qcov = (alnlen/qlen)*100; else qcov=0
            if (tlen>0) tcov = (alnlen/tlen)*100; else tcov=0
            if (qcov >= 50 && tcov >= 50 && pctid >= 60 && evalue <= 1e-5) {
                printf "%s\t%s\t%d\t%d\t%d\t%.2f\t%.2e\t%.2f\t%.2f\n", $1,$2,alnlen,qlen,tlen,pctid,evalue,qcov,tcov
            }
        }' "$output_raw" > "$output_final"
        hits_count=$(tail -n +2 "$output_final" 2>/dev/null | wc -l)
        echo "✓ Valid hits: $hits_count" >> "$log_file"
    else
        echo "X No hits" >> "$log_file"
        printf "Query\tTarget\tAlnLen\tQLen\tTLen\tPctID\tEvalue\tQCov\tTCov\n" > "$output_final"
    fi
    rm -f "$output_raw"
    echo "Finished: $(date)" >> "$log_file"
}

# ========== MAIN EXECUTION ==========
main() {
    check_environment
    cp -f "$VIS_SCRIPT" "$OUT_DIR/visualisation_functions_IMPORTA_FINAL.R"
    mapfile -t faa_files < <(find "$FAA_DIR" -name '*.faa' -type f | sort)
    total_samples=${#faa_files[@]}
    echo "Files to process: $total_samples"

    available_cores=$(nproc)
    jobs_count=$((available_cores * 80 / 100))
    jobs_count=$((jobs_count < 1 ? 1 : jobs_count))
    jobs_count=$((jobs_count > 39 ? 39 : jobs_count))
    echo "Parallel jobs: $jobs_count"

    export -f process_sample get_genome_id
    export OUT_DIR BASE_DB LOG_DIR TEMP_DIR

    printf '%s\n' "${faa_files[@]}" | parallel \
        --progress --bar --eta --jobs "$jobs_count" \
        --memfree 2G --load 80% --retries 2 \
        --halt now,fail=10% --joblog "$LOG_DIR/parallel_jobs.log" \
        "process_sample {}" 2>&1 | tee "$LOG_DIR/parallel_output.log"

    result_files=($(find "$OUT_DIR/usearch" -name '*.tsv' -type f))
    echo "Files generated: ${#result_files[@]}"

    # Run R analysis with the two metadata files
    echo "=== RUNNING R ANALYSIS ==="
    if Rscript --vanilla "$R_SCRIPT" "$SPECIES_METADATA" "$OUT_DIR" "$BASE_DB" "$GENE_METADATA" 2>&1 | tee "$LOG_DIR/R_analysis.log"; then
        echo "✓ R analysis completed"
    else
        echo "X Error in R analysis"
        exit 1
    fi

    rm -rf "$TEMP_DIR"
    echo "=== PIPELINE COMPLETED ==="
    echo "Results in: $OUT_DIR"
    echo "Logs: $LOG_DIR"
}

mkdir -p "$LOG_DIR"
if ! main 2>&1 | tee "$LOG_DIR/pipeline_master.log"; then
    echo "X Pipeline failed"
    exit 1
fi

