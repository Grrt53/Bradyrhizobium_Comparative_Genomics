#!/usr/bin/env python3

import csv
from pathlib import Path

# ========= CONFIGURATION =========
INPUT_FILE = "XXX/XX/X/X/XX//genes_gly_1/genes_por_especie.csv"
DELIMITER = ","   # <-- FIXED: now uses comma
# =================================

def main():
    input_path = Path(INPUT_FILE)

    if not input_path.is_file():
        print(f"X Error: File not found:\n   {input_path}")
        print("   Check the path and make sure the disk is mounted.")
        return

    # Output file name
    output_path = input_path.parent / f"{input_path.stem}_percentage.csv"

    try:
        with open(input_path, 'r', newline='', encoding='utf-8') as f_in:
            reader = csv.DictReader(f_in, delimiter=DELIMITER)
            fields = reader.fieldnames

            if 'species' not in fields or 'genomes' not in fields:
                print("X The file must contain the columns 'species' and 'genomes'.")
                return

            processed_rows = []

            for row in reader:
                try:
                    total_genomes = float(row['genomes'])
                except ValueError:
                    print(f"X  Skipping species {row.get('species', '?')}: 'genomes' value is not numeric.")
                    continue

                factor = 100.0 / total_genomes if total_genomes != 0 else 0.0
                new_row = {}

                for field in fields:
                    if field == 'species':
                        new_row[field] = row[field]
                    elif field == 'genomes':
                        new_row[field] = row[field]  # original number is kept
                    else:
                        try:
                            count = float(row[field])
                        except ValueError:
                            count = 0.0
                        percentage = round(count * factor, 2)
                        new_row[field] = f"{percentage:.2f}"

                processed_rows.append(new_row)

        # Save result
        with open(output_path, 'w', newline='', encoding='utf-8') as f_out:
            writer = csv.DictWriter(f_out, fieldnames=fields, delimiter=DELIMITER)
            writer.writeheader()
            writer.writerows(processed_rows)

        print(f"OK Conversion completed.")
        print(f"PASTA File generated: {output_path}")

    except Exception as e:
        print(f"X Unexpected error: {e}")

if __name__ == "__main__":
    main()






























